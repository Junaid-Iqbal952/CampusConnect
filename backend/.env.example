# Copy this file to backend/.env and fill in the real values.
# NEVER commit .env - it's already in .gitignore.

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (URI)
# Ask the teammate who set up Supabase for the password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Any long random string. Everyone on the team should use the SAME one.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@cloudname